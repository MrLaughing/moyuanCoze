<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper_bg">

    <!-- 标题行：图鉴 + 已解锁数量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin_lg"
        android:paddingEnd="@dimen/screen_margin_lg"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/white">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nav_catalog"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:fontFamily="@font/jinghua_laosong"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_unlocked_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin_lg"
        android:paddingEnd="@dimen/screen_margin_lg"
        android:paddingTop="@dimen/screen_margin"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/filter_all"
            style="@style/PillTag.Dark"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/label_cat_all" />

        <TextView
            android:id="@+id/filter_discovered"
            style="@style/PillTag.Light"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/catalog_filter_discovered" />

        <TextView
            android:id="@+id/filter_undiscovered"
            style="@style/PillTag.Light"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/catalog_filter_undiscovered" />
    </LinearLayout>

    <!-- 植物卡片网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_catalog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/screen_margin"
        android:clipToPadding="false" />

</LinearLayout>
